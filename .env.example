OPENROUTER_API_KEY=your_key_here
# Model used for generation. Default: claude-sonnet-4-6 (best quality for content + notes).
# To cut cost on test runs, flip to a VERIFIED Gemini Flash id from openrouter.ai/models
# (e.g. google/gemini-2.5-flash) — "gemini-3.5-flash" is not a real id.
OPENROUTER_MODEL=anthropic/claude-sonnet-4-6
